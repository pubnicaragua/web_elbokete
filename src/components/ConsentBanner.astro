---
/**
 * Aviso de cookies. Solo se dibuja si el sitio tiene analítica configurada
 * (PUBLIC_ANALYTICS_ID): sin ella no hay nada que consentir y no se muestra.
 *
 * Reglas:
 * - Nada de analítica se carga antes de que el visitante la acepte.
 * - Aceptar y rechazar son igual de fáciles (dos botones del mismo tamaño).
 * - La decisión se guarda en la cookie `bokete_consent` por 6 meses y se puede cambiar
 *   desde "Preferencias de cookies" en el pie de página.
 * - Google Analytics 4 se carga con Consent Mode v2: todo en "denied" hasta aceptar.
 */
interface Props {
  analyticsId: string;
}

const { analyticsId } = Astro.props;
---

<div
  id="consent"
  class="consent"
  role="dialog"
  aria-modal="false"
  aria-labelledby="consent-title"
  data-analytics-id={analyticsId}
  hidden
>
  <h2 id="consent-title">Cookies</h2>
  <p>
    Usamos una cookie necesaria para recordar tu elección y, si lo permites, cookies de analítica para saber qué
    partes del sitio se usan y mejorarlo. Puedes cambiarlo cuando quieras. <a href="/cookies">Más información</a>
  </p>
  <div class="consent__actions">
    <button type="button" class="button" data-consent="reject">Solo las necesarias</button>
    <button type="button" class="button" data-consent="accept">Aceptar analítica</button>
  </div>
</div>

<style>
  .consent {
    position: fixed;
    inset: auto 16px 16px 16px;
    max-width: 560px;
    margin-inline: auto;
    z-index: 20;
    background: #fff;
    color: var(--ink);
    border-radius: var(--radius);
    box-shadow: 0 12px 40px rgb(17 27 23 / 25%);
    padding: 20px 24px;
  }
  .consent[hidden] {
    display: none;
  }
  .consent h2 {
    font-size: 1.2rem;
    margin-bottom: 8px;
  }
  .consent p {
    margin: 0 0 16px;
    font-size: 0.9rem;
  }
  .consent__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .consent__actions .button {
    flex: 1 1 180px;
    justify-content: center;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }
</style>

<script>
  const COOKIE = 'bokete_consent';
  const SIX_MONTHS = 60 * 60 * 24 * 180;
  const box = document.getElementById('consent') as HTMLElement | null;
  const id = box?.dataset.analyticsId;

  function readChoice(): 'accepted' | 'rejected' | null {
    const m = document.cookie.match(new RegExp(`(?:^|; )${COOKIE}=(accepted|rejected)`));
    return (m?.[1] as 'accepted' | 'rejected' | undefined) ?? null;
  }

  function saveChoice(value: 'accepted' | 'rejected') {
    const secure = location.protocol === 'https:' ? '; Secure' : '';
    document.cookie = `${COOKIE}=${value}; Max-Age=${SIX_MONTHS}; Path=/; SameSite=Lax${secure}`;
  }

  let loaded = false;
  function loadAnalytics() {
    if (loaded || !id) return;
    loaded = true;
    const w = window as unknown as { dataLayer: unknown[]; gtag: (...a: unknown[]) => void };
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () {
      // gtag exige el objeto `arguments`, no un arreglo.
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer.push(arguments);
    };
    w.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
    w.gtag('js', new Date());
    w.gtag('consent', 'update', { analytics_storage: 'granted' });
    w.gtag('config', id, { anonymize_ip: true });
    const s = document.createElement('script');
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
    document.head.appendChild(s);
  }

  function apply(choice: 'accepted' | 'rejected' | null) {
    if (choice === null) box?.removeAttribute('hidden');
    else box?.setAttribute('hidden', '');
    if (choice === 'accepted') loadAnalytics();
  }

  box?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => {
      const choice = b.dataset.consent === 'accept' ? 'accepted' : 'rejected';
      saveChoice(choice);
      // Si ya se había aceptado antes y ahora rechaza, se recarga para soltar los scripts de analítica.
      if (choice === 'rejected' && loaded) location.reload();
      apply(choice);
    }),
  );
  document.querySelectorAll('[data-consent-open]').forEach((b) => b.addEventListener('click', () => apply(null)));

  apply(readChoice());
</script>
