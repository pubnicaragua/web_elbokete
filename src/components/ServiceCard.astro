---
import { formatMoney, unitLabel, type Service } from '../lib/api';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const priced = service.priceFrom.minorUnits > 0;
const image = service.imageUrls[0];
---

<a class="card" href={`/servicios/${service.id}`}>
  <div class="card__image" role="img" aria-label={image ? service.name : ''}>
    {image && <img src={image} alt="" loading="lazy" decoding="async" />}
  </div>
  <div class="card__body">
    <h3>{service.name}</h3>
    {service.description && <p class="muted">{service.description}</p>}
    {
      service.tags.length > 0 && (
        <ul class="tags">
          {service.tags.slice(0, 3).map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }
    {
      priced && (
        <p class="card__price">
          <small>Desde</small> {formatMoney(service.priceFrom)} <small>{unitLabel(service.priceUnit)}</small>
        </p>
      )
    }
  </div>
</a>

<style>
  .card__image {
    aspect-ratio: 16 / 10;
    background: var(--sand) url('/topo/topo_centered.svg') center / cover;
  }
  .card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
