# Dirección de la API de El Bokete que se lee al compilar el sitio.
# Local: la API corre en el puerto 3000.
PUBLIC_API_URL=http://localhost:3000

# Dirección pública del sitio (para los enlaces absolutos).
PUBLIC_SITE_URL=http://localhost:4321

# Analítica (opcional). Sin este valor no hay analítica y el aviso de cookies no se muestra.
# Es el identificador de Google Analytics 4 (G-XXXXXXXXXX). Solo se carga si el visitante acepta.
PUBLIC_ANALYTICS_ID=
